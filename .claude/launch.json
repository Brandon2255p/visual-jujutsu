{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "webview-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server \"${PORT:-5178}\" --bind 127.0.0.1"
      ],
      "port": 5178
    },
    {
      "name": "site",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server \"${PORT:-5180}\" --bind 127.0.0.1 --directory site"
      ],
      "port": 5180
    }
  ]
}
