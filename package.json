{
  "name": "visual-jujutsu",
  "displayName": "Visual Jujutsu",
  "description": "See and edit your Jujutsu (jj) revision graph: describe, rebase, move files and bookmarks, push and open pull requests.",
  "version": "1.3.0",
  "publisher": "OpenProcess",
  "author": "Brandon",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1d21",
    "theme": "dark"
  },
  "homepage": "https://github.com/Brandon2255p/visual-jujutsu#readme",
  "bugs": {
    "url": "https://github.com/Brandon2255p/visual-jujutsu/issues"
  },
  "qna": "https://github.com/Brandon2255p/visual-jujutsu/discussions",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/Brandon2255p/visual-jujutsu.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "jj",
    "jujutsu",
    "git",
    "graph",
    "rebase",
    "version control",
    "pull request",
    "stacked diffs"
  ],
  "activationEvents": [
    "workspaceContains:.jj",
    "workspaceContains:*/.jj"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visualJujutsu",
          "title": "Visual Jujutsu",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "visualJujutsu": [
        {
          "id": "visualJujutsu.graph",
          "name": "Visual Jujutsu",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "visualJujutsu.refresh",
        "title": "Refresh",
        "category": "Visual Jujutsu",
        "icon": "$(refresh)"
      },
      {
        "command": "visualJujutsu.fetch",
        "title": "Fetch",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.push",
        "title": "Push…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.undo",
        "title": "Undo Last Operation",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.redo",
        "title": "Redo Operation",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.showCommandLog",
        "title": "Show Command Log",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.describe",
        "title": "Describe Revision…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.newRevision",
        "title": "New Revision…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.edit",
        "title": "Edit (Check Out) Revision…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.abandon",
        "title": "Abandon Revision…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.squashIntoParent",
        "title": "Squash Revision into Parent…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.rebase",
        "title": "Rebase…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.rebaseOnTrunk",
        "title": "Rebase on Main",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.createBookmark",
        "title": "Create Bookmark…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.moveBookmark",
        "title": "Move Bookmark…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.createPullRequest",
        "title": "Create Pull Request…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.movePullRequest",
        "title": "Move Pull Request to Revision…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.absorb",
        "title": "Absorb Changes into Stack…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.split",
        "title": "Split Revision…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.rebaseAllOnTrunk",
        "title": "Rebase All My Stacks on Main",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.trackBookmarks",
        "title": "Track / Untrack Remote Bookmarks…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.switchRepository",
        "title": "Switch Repository…",
        "category": "Visual Jujutsu"
      },
      {
        "command": "visualJujutsu.scmNewRevision",
        "title": "New Revision",
        "category": "Visual Jujutsu",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "visualJujutsu.refresh",
          "when": "view == visualJujutsu.graph",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "visualJujutsu.scmNewRevision",
          "when": "scmProvider == jj",
          "group": "navigation"
        },
        {
          "command": "visualJujutsu.refresh",
          "when": "scmProvider == jj",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "visualJujutsu.scmNewRevision",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Visual Jujutsu",
      "properties": {
        "visualJujutsu.jjPath": {
          "type": "string",
          "default": "jj",
          "description": "Path to the jj executable."
        },
        "visualJujutsu.ghPath": {
          "type": "string",
          "default": "gh",
          "description": "Path to the GitHub CLI, used for pull requests."
        },
        "visualJujutsu.defaultRevset": {
          "type": "string",
          "default": "",
          "description": "Revset shown when the graph opens. Empty uses jj's own default (revsets.log)."
        },
        "visualJujutsu.savedRevsets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "revset": {
                "type": "string"
              }
            }
          },
          "default": [],
          "description": "Extra revset presets shown in the graph's preset list."
        },
        "visualJujutsu.density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ],
          "enumDescriptions": [
            "28px rows (default)",
            "22px rows and smaller descriptions, to fit more revisions"
          ],
          "default": "comfortable",
          "description": "Row density in the graph, file lists, operation log and pull requests view."
        },
        "visualJujutsu.fileView": {
          "type": "string",
          "enum": [
            "list",
            "folders"
          ],
          "enumDescriptions": [
            "A flat list, with each file's folder beside its name (default)",
            "Files under their folders, like the Explorer"
          ],
          "default": "list",
          "description": "How a revision's changed files are shown in the graph and the evolution log."
        },
        "visualJujutsu.logLimit": {
          "type": "number",
          "default": 200,
          "description": "Maximum number of revisions to load."
        },
        "visualJujutsu.fetchBeforeRebaseOnTrunk": {
          "type": "boolean",
          "default": true,
          "description": "Run jj git fetch before \"Rebase on main\"."
        },
        "visualJujutsu.pullRequestBookmarkPrefix": {
          "type": "string",
          "default": "push-",
          "description": "Prefix for bookmarks created when you open a pull request from a revision without one."
        },
        "visualJujutsu.linkGitHubStacks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "After **Create PRs for stack** and **Sync stack**, link the PRs into a native GitHub stack with `gh stack link`. Only runs when the [gh stack](https://github.com/github/gh-stack) extension is installed."
        },
        "visualJujutsu.confirmDestructiveActions": {
          "type": "boolean",
          "default": true,
          "description": "Ask before abandoning revisions or moving bookmarks backwards."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "test": "vitest run",
    "package": "npx @vscode/vsce package --no-dependencies",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "vscode:prepublish": "npm run build",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "gifs": "npm run build && node scripts/gifs.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "preact": "^11.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
